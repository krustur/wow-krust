local level, xp, maxXP, now
local eventFrame, display, frames, output
local objects

local function newObject()
    local object = { shown = true, scripts = {} }
    objects[#objects + 1] = object
    function object:SetWidth(value) self.width = value end
    function object:SetHeight(value) self.height = value end
    function object:SetPoint(...) self.point = { ... } end
    function object:SetAllPoints(...) self.allPoints = { ... } end
    function object:SetTexture(...) self.color = { ... } end
    function object:SetText(value) self.text = value end
    function object:SetJustifyH(value) self.justify = value end
    function object:Show() self.shown = true end
    function object:Hide() self.shown = false end
    function object:SetMovable(value) self.movable = value end
    function object:EnableMouse(value) self.mouse = value end
    function object:RegisterForDrag(value) self.dragButton = value end
    function object:SetClampedToScreen(value) self.clamped = value end
    function object:StartMoving() self.moving = true end
    function object:StopMovingOrSizing() self.moving = false end
    function object:GetLeft() return self.left end
    function object:GetTop() return self.top end
    function object:GetBottom() return self.bottom end
    function object:RegisterEvent(name) self.events = self.events or {}; self.events[name] = true end
    function object:SetScript(name, handler) self.scripts[name] = handler end
    function object:CreateTexture()
        local texture = newObject()
        self.textures = self.textures or {}
        self.textures[#self.textures + 1] = texture
        return texture
    end
    function object:CreateFontString()
        local text = newObject()
        self.strings = self.strings or {}
        self.strings[#self.strings + 1] = text
        return text
    end
    return object
end

local realPrint = print
local function setup(db)
    level, xp, maxXP, now = 10, 100, 1000, 0
    frames, output, objects = {}, {}, {}
    UIParent = newObject()
    UIParent.left, UIParent.bottom = 10, 20
    function CreateFrame()
        local frame = newObject()
        frames[#frames + 1] = frame
        return frame
    end
    function UnitLevel() return level end
    function UnitXP() return xp end
    function UnitXPMax() return maxXP end
    function GetTime() return now end
    function print(message) output[#output + 1] = message end
    KrustDB = db
    SlashCmdList = {}
    assert(loadfile("addons/Krust/Krust.lua"))("Krust")
    eventFrame = frames[1]
end

local function event(name, arg)
    assert(eventFrame.events[name], name)
    eventFrame.scripts.OnEvent(eventFrame, name, arg)
    display = frames[2]
end

local function tick(seconds)
    now = now + seconds
    eventFrame.scripts.OnUpdate(eventFrame, seconds)
end

local function expect(actual, expected)
    assert(actual == expected, "expected " .. tostring(expected) .. ", got " .. tostring(actual))
end

local function gain(value)
    xp = xp + value
    event("PLAYER_XP_UPDATE", "player")
end

