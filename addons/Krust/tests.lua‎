    frames, output, objects = {}, {}, {}
    questEntries = {
        { title = "Elwynn Forest", isHeader = true, isCollapsed = false },
        { title = "Lost Necklace", level = 4, objectives = { "Necklaces recovered: 1/6" } },
        { title = "Into the Woods", level = 5, objectives = { "Timber Wolves slain: 5/10" } },
        { title = "Westfall", isHeader = true, isCollapsed = false },
        { title = "Westfall Watch", level = 10, objectives = { "Defias thugs slain: 2/12" } },
        { title = "Redridge Mountains", isHeader = true, isCollapsed = false },
        { title = "Redridge Alert", level = 16, objectives = { "Gnolls slain: 1/8" } },
    }

    UIParent = newObject()
    UIParent.left, UIParent.bottom = 10, 20
    function CreateFrame(frameType, name, parent, template)
        local frame = newObject()
        frame.frameType = frameType
        frame.name = name
        frame.parent = parent
        frame.template = template
        frames[#frames + 1] = frame
        return frame
    end

    QuestLogFrame = newObject()
    QuestLogFrame.shown = false

    function UnitLevel() return level end
    function UnitXP() return xp end
    function UnitXPMax() return maxXP end
    function GetXPExhaustion() return restedXP end
    function GetQuestGreenRange() return 5 end
    function GetTime() return now end
    function print(message) output[#output + 1] = message end
    function ToggleQuestLog()
        toggleQuestLogCalls = toggleQuestLogCalls + 1
        QuestLogFrame.shown = not QuestLogFrame.shown
    end
    function SelectQuestLogEntry(index)
        selectedQuest = index
    end
    function QuestLog_Update() end
    function GetNumQuestLogEntries()
        return #questEntries
    end
    function GetQuestLogTitle(index)
        local entry = questEntries[index]
        if not entry then return end
        if entry.isHeader then
            return entry.title, nil, nil, 1, entry.isCollapsed and 1 or 0
        end
        return entry.title, entry.level, nil, 0, 0
    end
    function ExpandQuestHeader(index)
        if index == 0 then
            for _, entry in ipairs(questEntries) do
                if entry.isHeader then
                    entry.isCollapsed = false
                end
            end
        elseif questEntries[index] and questEntries[index].isHeader then
            questEntries[index].isCollapsed = false
        end
    end
    function CollapseQuestHeader(index)
        if questEntries[index] and questEntries[index].isHeader then
            questEntries[index].isCollapsed = true
        end
    end
    function GetNumQuestLeaderBoards(index)
        local entry = questEntries[index]
        if not entry or entry.isHeader or not entry.objectives then
            return 0
        end
        return #entry.objectives
    end
    function GetQuestLogLeaderBoard(objectiveIndex, questIndex)
        local entry = questEntries[questIndex]
        if not entry or entry.isHeader or not entry.objectives then
            return nil
        end
        return entry.objectives[objectiveIndex]
    end

    KrustDB = db
    SlashCmdList = {}
    assert(loadfile("addons/Krust/Krust.lua"))("Krust")
    eventFrame = frames[1]
end

local function event(name, arg)
    assert(eventFrame.events[name], name)
    eventFrame.scripts.OnEvent(eventFrame, name, arg)
end

local function expect(actual, expected)
    assert(actual == expected, "expected " .. tostring(expected) .. ", got " .. tostring(actual))
end

local function expectApprox(actual, expected, tolerance)
    local delta = math.abs(actual - expected)
    assert(delta <= (tolerance or 0.0001), "expected " .. tostring(expected) .. ", got " .. tostring(actual))
end

local function findFrameByName(name)
    for _, frame in ipairs(frames) do
        if frame.name == name then
            return frame
        end
    end
end

local function findChildFrame(parent, matcher)
    for _, frame in ipairs(frames) do
        if frame.parent == parent and (not matcher or matcher(frame)) then
            return frame
        end
    end
end

local function findQuestRow(questContent, text)
    for _, frame in ipairs(frames) do
        if frame.parent == questContent and frame.text and frame.text.text == text and frame.shown then
            return frame
        end
    end
end

local function listQuestRowTexts(questContent)
    local rows = {}
    for _, frame in ipairs(frames) do
        if frame.parent == questContent and frame.text and frame.shown then
            rows[#rows + 1] = frame.text.text
        end
    end
    return rows
end

local function contains(values, expected)
    for _, value in ipairs(values) do
        if value == expected then
            return true
        end
    end
    return false
end

